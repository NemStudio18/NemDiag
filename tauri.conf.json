{
  "version": "0.5.0-beta.1",
  "build": {
    "frontendDist": "ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "identifier": "com.nemdiag.app",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nemdiag",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://diag-nem.flexcb.fr https://nemdiag.nhtml.ynh.fr;"
    }
  }
}
